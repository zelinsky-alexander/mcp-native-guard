{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcp-native-guard/tool-inventory-v1.schema.json",
  "title": "mcp-native-guard tool inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_version", "server", "tools"],
  "properties": {
    "inventory_version": {"const": 1},
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downstream_executable"],
      "properties": {
        "downstream_executable": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "description": {"type": "string", "maxLength": 8192},
          "inputSchema": {},
          "annotations": {}
        }
      }
    }
  }
}
